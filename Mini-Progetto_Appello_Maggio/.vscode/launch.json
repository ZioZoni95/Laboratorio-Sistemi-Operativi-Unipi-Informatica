{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug parallel_sort (-n 10 -w 4)", // Nome della configurazione di debug
            "type": "cppdbg", // Tipo di debugger (C++ per GDB)
            "request": "launch", // Tipo di richiesta: "launch" per avviare un programma
            "program": "${workspaceFolder}/parallel_sort", // Percorso dell'eseguibile
                                                         // Assicurati che 'parallel_sort' sia il nome corretto
                                                         // del tuo eseguibile nella directory principale.
            "args": [
                "-n",
                "10",
                "-w",
                "4"
            ], // Argomenti da passare al programma
            "stopAtEntry": true, // Imposta a true se vuoi che GDB si fermi all'inizio di main()
            "cwd": "${workspaceFolder}", // Directory di lavoro corrente
            "environment": [], // Eventuali variabili d'ambiente da impostare
            "externalConsole": false, // Usa la console di debug integrata in VSCode
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // Percorso di GDB (tipico per Ubuntu)
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Handle pending breakpoints",
                    "text": "set breakpoint pending on",
                    "ignoreFailures": true
                },
                {
                    "description": "Allow GDB to debug all threads; when one stops, others can continue",
                    "text": "set non-stop on", // Molto utile per il debugging multi-thread
                    "ignoreFailures": true
                },
                {
                    "description": "Follow child processes after a fork (non strettamente per pthreads ma innocuo)",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "make_parallel_sort" // Esegue la task 'make_parallel_sort'
                                                  // definita in tasks.json prima di avviare il debug
        }
    ]
}