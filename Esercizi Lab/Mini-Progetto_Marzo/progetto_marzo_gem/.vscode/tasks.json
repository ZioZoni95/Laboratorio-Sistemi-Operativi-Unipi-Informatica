// File: .vscode/tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            // Task per compilare il progetto
            "label": "make build",                  // Nome della task
            "type": "shell",                    // Tipo: esegue comando shell
            "command": "make",                  // Comando: esegue 'make' (userà il Makefile)
            "group": {
                "kind": "build",                // Tipo di task: build
                "isDefault": true               // Questa è la task di build predefinita (Ctrl+Shift+B)
            },
            "problemMatcher": [
                "$gcc"                          // Interpreta l'output di errori/warning GCC
            ],
            "detail": "Compila il progetto sum_calculator usando il Makefile" // Descrizione
        },
        {
            // Task per pulire i file compilati
            "label": "make clean",
            "type": "shell",
            "command": "make clean",            // Comando: esegue 'make clean'
            "problemMatcher": []                // Non serve interpretare output qui
        }
    ]
}