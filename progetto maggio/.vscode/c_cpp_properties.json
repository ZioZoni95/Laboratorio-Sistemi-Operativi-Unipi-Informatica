{
  "configurations": [
    {
      "name": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
                "_POSIX_C_SOURCE=200809L", // <<< Dice a IntelliSense di definire questa macro
                "_REENTRANT",              // Spesso utile con pthreads
                "_GNU_SOURCE"              // Abilita anche altre estensioni utili
            ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c17",
      "cppStandard": "gnu++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}